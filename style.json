{
  "version": 8,
  "sources": {
    "backcountry": {
      "type": "vector",
      "url": "pmtiles://https://pub-0f98a7bc5f124d2c91ecc5e8ae899144.r2.dev/ut/backcountry-ut.pmtiles"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "pmtiles://https://pub-0f98a7bc5f124d2c91ecc5e8ae899144.r2.dev/ut/terrain-ut.pmtiles",
      "tileSize": 512
    },
    "satellite": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "© Esri, Maxar, Earthstar Geographics"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#2b2f26" }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "satellite",
      "paint": { "raster-saturation": -0.15, "raster-brightness-max": 0.95 }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "layout": { "visibility": "visible" },
      "paint": {
        "hillshade-exaggeration": 0.3,
        "hillshade-shadow-color": "#1a1712",
        "hillshade-highlight-color": "#fffdf0",
        "hillshade-accent-color": "#000000"
      }
    },
    {
      "id": "public-land-usfs",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["any", ["==", ["get", "ADMIN_AGENCY_CODE"], "USFS"], ["has", "forestname"]],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#4f9d68",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.16, 9, 0.28, 13, 0.36],
        "fill-outline-color": "#2c5b3c"
      }
    },
    {
      "id": "public-land-blm",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["==", ["get", "ADMIN_AGENCY_CODE"], "BLM"],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#e0b073",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.16, 9, 0.28, 13, 0.36],
        "fill-outline-color": "#a97f45"
      }
    },
    {
      "id": "public-land-nps",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["==", ["get", "ADMIN_AGENCY_CODE"], "NPS"],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#a98fd2",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.18, 9, 0.30, 13, 0.40],
        "fill-outline-color": "#654f85"
      }
    },
    {
      "id": "public-land-state",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["==", ["get", "ADMIN_AGENCY_CODE"], "ST"],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#5fa8dd",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.16, 9, 0.28, 13, 0.36],
        "fill-outline-color": "#356c97"
      }
    },
    {
      "id": "public-land-fws",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["==", ["get", "ADMIN_AGENCY_CODE"], "FWS"],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#d98f66",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.16, 9, 0.28, 13, 0.36],
        "fill-outline-color": "#8f4f31"
      }
    },
    {
      "id": "public-land-dod",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["==", ["get", "ADMIN_AGENCY_CODE"], "DOD"],
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": "#b23a3a",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.18, 9, 0.28, 13, 0.34],
        "fill-outline-color": "#7a2424"
      }
    },
    {
      "id": "wilderness",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "wilderness",
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": "#2f5d43",
        "fill-opacity": 0.28,
        "fill-outline-color": "#1f4530"
      }
    },
    {
      "id": "public-land-usfs-label",
      "type": "symbol",
      "source": "backcountry",
      "source-layer": "public_land",
      "filter": ["has", "forestname"],
      "minzoom": 8,
      "layout": {
        "visibility": "visible",
        "text-field": ["get", "forestname"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 8,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#2c5b3c",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "wilderness-label",
      "type": "symbol",
      "source": "backcountry",
      "source-layer": "wilderness",
      "filter": ["has", "wildernessname"],
      "minzoom": 9,
      "layout": {
        "visibility": "none",
        "text-field": ["get", "wildernessname"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#1f4530",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "contours",
      "type": "line",
      "source": "backcountry",
      "source-layer": "contours",
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": "#f2e9d8",
        "line-width": [
          "case",
          ["==", ["%", ["get", "elevation"], 200], 0],
          1.1,
          0.5
        ],
        "line-opacity": 0.5
      }
    },
    {
      "id": "cell-coverage",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "cell_coverage",
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": "#4a90c2",
        "fill-opacity": 0.22
      }
    },
    {
      "id": "mvum-routes-dispersed",
      "type": "line",
      "source": "backcountry",
      "source-layer": "mvum_routes",
      "filter": ["to-boolean", ["get", "dispersed_camping"]],
      "layout": { "visibility": "visible", "line-cap": "round" },
      "paint": {
        "line-color": "#ff9a52",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 2.8],
        "line-dasharray": [1, 0]
      }
    },
    {
      "id": "mvum-routes-other",
      "type": "line",
      "source": "backcountry",
      "source-layer": "mvum_routes",
      "filter": ["!", ["to-boolean", ["get", "dispersed_camping"]]],
      "layout": { "visibility": "none", "line-cap": "round" },
      "paint": {
        "line-color": "#e8d9b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 2.8],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "trails",
      "type": "line",
      "source": "backcountry",
      "source-layer": "trails",
      "layout": { "visibility": "visible" },
      "paint": {
        "line-color": "#fff4d6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.7, 15, 2.2],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "closures",
      "type": "fill",
      "source": "backcountry",
      "source-layer": "closures",
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "#e53e2e",
        "fill-opacity": 0.45,
        "fill-outline-color": "#7d1f16"
      }
    },
    {
      "id": "developed-rec",
      "type": "circle",
      "source": "backcountry",
      "source-layer": "developed_rec",
      "layout": { "visibility": "visible" },
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 7, 3, 11, 5, 15, 8],
        "circle-color": [
          "match", ["get", "markeractivitygroup"],
          "Camping & Cabins", "#ff9a52",
          "Picnicking", "#4f9d68",
          "Hiking", "#c99a5b",
          "Fishing", "#5fa8dd",
          "Water Activities", "#5fa8dd",
          "OHV Riding & Camping", "#e0763f",
          "#c8c8c8"
        ],
        "circle-stroke-width": 1.4,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "developed-rec-label",
      "type": "symbol",
      "source": "backcountry",
      "source-layer": "developed_rec",
      "filter": ["has", "recareaname"],
      "minzoom": 11,
      "layout": {
        "visibility": "visible",
        "text-field": ["get", "recareaname"],
        "text-size": 11,
        "text-offset": [0, 1.1],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#2b2f26",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 1.2
      }
    }
  ]
}
